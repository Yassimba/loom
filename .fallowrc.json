{
  "$schema": "https://docs.fallow.tools/schemas/fallowrc.json",
  "entry": [
    "plugins/*/src/index.ts",
    "plugins/*/src/*/index.ts",
    "manifest/opencode/plugins/*.js",
    "test/pi-skill-discovery.mjs"
  ],
  "ignorePatterns": [
    "skills/**",
    "drafts/**",
    "**/*.generated.*",
    "plugins/pi-loom-mermaid/src/loom-mermaid/**"
  ],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 20,
    "maxCrap": 250
  },
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
