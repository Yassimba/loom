{
  "$schema": "https://docs.fallow.tools/schemas/fallowrc.json",
  "entry": ["plugins/*/src/index.ts", "plugins/*/src/*/index.ts", "manifest/opencode/plugins/*.js"],
  "ignorePatterns": ["skills/**", "drafts/**", "**/*.generated.*"],
  "ignoreDependencies": [],
  "ignoreExportsUsedInFile": true,
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 20,
    "maxCrap": 250
  },
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
