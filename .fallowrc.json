{
  "$schema": "https://docs.fallow.tools/schemas/fallowrc.json",
  "entry": [
    "plugins/*/src/index.ts",
    "plugins/*/src/*/index.ts",
    "plugins/*/hooks/register.tsx",
    "plugins/*/tests/*.test.tsx",
    "manifest/opencode/plugins/*.js",
    "test/pi-skill-discovery.mjs",
    "scripts/mermaid-compare.ts"
  ],
  "ignorePatterns": [
    "skills/**",
    "drafts/**",
    "**/*.generated.*",
    "plugins/pi-loom-mermaid/src/loom-mermaid/**"
  ],
  "ignoreDependencies": ["claude-code"],
  "ignoreExportsUsedInFile": true,
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 20,
    "maxCrap": 250
  },
  "audit": {
    "deadCodeBaseline": ".fallow-baselines/pi-guardrails-dead-code.json",
    "healthBaseline": ".fallow-baselines/pi-guardrails-health.json",
    "dupesBaseline": ".fallow-baselines/pi-guardrails-dupes.json"
  },
  "rules": {
    "dev-dependencies-in-production": "off"
  }
}
