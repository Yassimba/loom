{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node", "react", "react-dom"],
    "paths": {
      "virtual:progressive-review-authoring": [
        "./skills/code-diagram/scripts/src/authoring/virtual.ts"
      ],
      "@dev.fast/progressive-review/software-map-model": [
        "./skills/code-diagram/scripts/src/diagrams/software-map/model.ts"
      ]
    }
  },
  "include": [
    "skills/code-diagram/scripts/**/*.ts",
    "skills/code-diagram/scripts/**/*.tsx",
    "skills/code-diagram/fixtures/data.ts",
    "skills/code-diagram/examples/**/*.ts",
    "test/code-diagram.test.ts",
    "test/code-diagram-routing.test.ts"
  ]
}
