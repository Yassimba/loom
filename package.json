{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "description": "Development workspace for Yassimba's agent skills and Pi extensions",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "catalog:generate": "node scripts/generate-setup-catalog.mjs",
    "catalog:check": "node scripts/generate-setup-catalog.mjs --check",
    "check:rust": "cargo fmt --manifest-path cli/loom/Cargo.toml -- --check && cargo clippy --manifest-path cli/loom/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path cli/loom/Cargo.toml",
    "test": "node --import tsx --test test/*.test.mjs test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.code-diagram.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "audit": "fallow audit",
    "audit:brief": "fallow review --brief",
    "pack:check": "npm pack --dry-run --workspaces",
    "check:js": "npm test && npm run typecheck && npm run lint && npm run catalog:check && npm run pack:check",
    "check": "npm run check:js && npm run check:rust"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@earendil-works/pi-tui": "0.80.5",
    "@mdx-js/mdx": "3.1.1",
    "@mr_mint/elkjs-libavoid": "^0.5.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@xyflow/react": "12.10.2",
    "elkjs": "^0.11.1",
    "esbuild": "0.28.1",
    "fallow": "3.6.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "tsx": "4.21.0",
    "typebox": "1.3.6",
    "typescript": "7.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
