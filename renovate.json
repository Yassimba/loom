{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],

  "minimumReleaseAge": "5 days",
  "automerge": true,

  "mise": {
    "managerFilePatterns": ["/(^|/)mise\\.toml$/", "/^manifest/loom\\.toml$/"]
  },

  "customManagers": [
    {
      "description": "Pi package pins in the setup manifest; the catalog-autofix workflow regenerates the embedded catalog on these PRs",
      "customType": "regex",
      "managerFilePatterns": ["/^manifest/pi-packages\\.json$/"],
      "matchStrings": [
        "\"name\": \"(?<depName>[^\"]+)\",\\s*\"version\": \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm"
    },
    {
      "description": "Keep the SkillSpector pin in the security workflow current",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/security\\.yml$/"],
      "matchStrings": [
        "skillspector\\.git@(?<currentDigest>[a-f0-9]{40}).*# (?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "NVIDIA/skillspector",
      "datasourceTemplate": "github-tags"
    }
  ],

  "packageRules": [
    {
      "description": "Major updates require manual review before merge",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Scanner bumps rewrite the gate itself, so they never automerge",
      "matchPackageNames": ["NVIDIA/skillspector"],
      "automerge": false
    },
    {
      "description": "Skip this repo's own binary pins: release.yml writes them after each release",
      "matchFileNames": ["manifest/loom.toml"],
      "matchPackageNames": ["Yassimba/loom"],
      "enabled": false
    }
  ],

  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "description": "CVE fixes skip the 5-day cooldown but still require manual review, so a malicious release disguised as a security patch cannot automerge",
    "automerge": false,
    "labels": ["security-fastlane"]
  }
}
